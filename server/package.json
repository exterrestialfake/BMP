{
  "name": "bilibili-audio-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=../plugins/bilibili-audio/server/index.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke:playback": "node --import tsx scripts/smoke-playback.ts",
    "smoke:search": "node --import tsx scripts/smoke-search.ts",
    "smoke:sequential": "node --import tsx scripts/smoke-sequential.ts",
    "smoke:cover": "node --import tsx scripts/smoke-cover.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
